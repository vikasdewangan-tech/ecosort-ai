# ==============================================
# EcoSort AI - Backend Environment Variables
# ==============================================
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to GitHub.

# Your AI vision API key (e.g. from OpenAI: https://platform.openai.com/api-keys)
AI_API_KEY=

# The AI provider endpoint (OpenAI-compatible chat completions endpoint)
AI_API_URL=https://api.openai.com/v1/chat/completions

# The vision-capable model to use
AI_MODEL=gpt-4o-mini

# Port the backend server will run on
PORT=5000

# The frontend URL allowed to call this backend (for CORS)
FRONTEND_URL=http://localhost:3000
